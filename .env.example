WOOCOMMERCE_STORE_URL=https://example.com
WOOCOMMERCE_CONSUMER_KEY=ck_your_key_here
WOOCOMMERCE_CONSUMER_SECRET=cs_your_secret_here

# Optional. Set before deploying anywhere public.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
APP_AUTH_SECRET=

# Required on Vercel for reviews and all durable Updated List data/workflows.
# Use Vercel KV or Upstash Redis REST credentials.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional. The default "shared" namespace lets local, staging, and production
# use the same cache when they point to the same Upstash database.
# Set different values only when you want to isolate environments.
UPDATED_LIST_CACHE_NAMESPACE=
